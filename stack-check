#!/usr/bin/env bash
# stack-check: post-CLI agentic stack verification (5 layers + optional signals).
# Layers map to the Agentic Coding Stack (see readiness-checklist.md):
#   https://blog.devgenius.io/the-agentic-coding-stack-7-tools-5-layers-and-the-missing-link-nobody-has-built-yet-de264b260db3
# See readiness-checklist.md for what cannot be automated. This script does not
# fetch the blog or GitHub at runtime; on failure it prints Remediate lines (link + example command).
#
# Env:
#   STACK_CHECK_STRICT=1           any WARN (including advisory) counts as failure (exit 1)
#   STACK_CHECK_NO_REMEDIATION=1   omit Remediate blocks
#   STACK_CHECK_DEGRADED_EXIT=1    exit 2 when any WARN and no hard FAIL (default exit 0 if only warnings)
#
# Optional: .stack-check.yaml (or .yml) in cwd — simple "key: value" lines (see .stack-check.yaml.example).

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# shellcheck disable=SC2034
READINESS_DOC="${SCRIPT_DIR}/readiness-checklist.md"

if [[ -t 1 ]]; then
  GREEN=$'\033[0;32m' RED=$'\033[0;31m' YELLOW=$'\033[1;33m' CYAN=$'\033[0;36m' DIM=$'\033[0;90m' NC=$'\033[0m'
else
  GREEN='' RED='' YELLOW='' CYAN='' DIM='' NC=''
fi

REQ_L1=1
REQ_L2=1
REQ_L3=1
REQ_L3_CTXO=0
REQ_L4_RTK=0
REQ_L4_CONTEXT_MODE=0
REQ_L5_GIT=1
REQ_L5_GSD=0
REQ_L2_SUPERPOWERS=0
PHASE=""

HARD_FAIL=0
ANY_WARN=0
FAIL_N=0
WARN_N=0
STRICT="${STACK_CHECK_STRICT:-0}"
NO_REMED="${STACK_CHECK_NO_REMEDIATION:-0}"
DEGR_EXIT="${STACK_CHECK_DEGRADED_EXIT:-0}"

# Comma-separated short tags for the VERDICT summary (e.g. "L1: specs/").
_ADDR_FAIL=""
_ADDR_WARN=""

add_addr_fail() {
  local t=$1
  [[ -n "$_ADDR_FAIL" ]] && _ADDR_FAIL+=", "
  _ADDR_FAIL+="$t"
}
add_addr_warn() {
  local t=$1
  [[ -n "$_ADDR_WARN" ]] && _ADDR_WARN+=", "
  _ADDR_WARN+="$t"
}

load_simple_yaml() {
  local f=$1
  [[ -f "$f" ]] || return 0
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    local line="${raw%%#*}"
    line="${line//[$'\r']/}"
    [[ -z "${line// }" ]] && continue
    if [[ "$line" =~ ^[[:space:]]*phase:[[:space:]]*(.+) ]]; then
      local val="${BASH_REMATCH[1]}"
      val="${val//\"/}"
      val="${val#"${val%%[![:space:]]*}"}"
      val="${val%"${val##*[![:space:]]}"}"
      PHASE="$val"
    elif [[ "$line" == *"require_layer1:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L1=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L1=0
    elif [[ "$line" == *"require_layer2:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L2=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L2=0
    elif [[ "$line" == *"require_layer2_superpowers:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L2_SUPERPOWERS=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L2_SUPERPOWERS=0
    elif [[ "$line" == *"require_layer3:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L3=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L3=0
    elif [[ "$line" == *"require_layer3_ctxo:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L3_CTXO=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L3_CTXO=0
    elif [[ "$line" == *"require_layer4_rtk:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L4_RTK=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L4_RTK=0
    elif [[ "$line" == *"require_layer4_context_mode:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L4_CONTEXT_MODE=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L4_CONTEXT_MODE=0
    elif [[ "$line" == *"require_layer5_gitsurface:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L5_GIT=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L5_GIT=0
    elif [[ "$line" == *"require_layer5_gsd:"* ]]; then
      [[ "$line" =~ :[[:space:]]*true|:[[:space:]]*1$ ]] && REQ_L5_GSD=1
      [[ "$line" =~ :[[:space:]]*false|:[[:space:]]*0$ ]] && REQ_L5_GSD=0
    fi
  done <"$f"
}

if [[ -f .stack-check.yaml ]]; then
  load_simple_yaml .stack-check.yaml
elif [[ -f .stack-check.yml ]]; then
  load_simple_yaml .stack-check.yml
fi

# Agentic Coding Stack (layers / tools): human-readable reference for remediation.
STACK_GUIDE_URL="https://blog.devgenius.io/the-agentic-coding-stack-7-tools-5-layers-and-the-missing-link-nobody-has-built-yet-de264b260db3"
SUPERPOWERS_INSTALL_URL="https://github.com/obra/superpowers"
CTXO_DOC_URL="https://alperhankendi.github.io/Ctxo/docs/introduction/mcp-client-setup"

# Repo-local Superpowers / obra signal (no network). See readiness-checklist Layer 2.
layer2_superpowers_signal() {
  if [[ -f skills/using-superpowers/SKILL.md ]] || [[ -f .claude/skills/using-superpowers/SKILL.md ]] || [[ -f .cursor/skills/using-superpowers/SKILL.md ]]; then
    return 0
  fi
  if [[ -d .claude/skills ]] && grep -rqE 'obra/superpowers|using-superpowers' .claude/skills 2>/dev/null; then
    return 0
  fi
  if [[ -d skills ]] && grep -rqE 'obra/superpowers|using-superpowers' skills 2>/dev/null; then
    return 0
  fi
  if [[ -d .cursor/skills ]] && grep -rqE 'obra/superpowers|using-superpowers' .cursor/skills 2>/dev/null; then
    return 0
  fi
  local f
  for f in README.md AGENTS.md CLAUDE.md .cursorrules instructions.md .clinerules; do
    [[ -f "$f" ]] || continue
    if grep -qiE 'obra/superpowers|superpowers@superpowers-marketplace|superpowers@claude-plugins-official|/add-plugin[[:space:]]+superpowers|plugin install[[:space:]]+superpowers' "$f" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

# Ctxo health (Layer 3) based on config/index/runtime shell-detectable evidence.
layer3_ctxo_health() {
  CTXO_CFG_FOUND=0
  CTXO_IDX_FOUND=0
  CTXO_RUNTIME_FOUND=0
  CTXO_STATE="warn"
  CTXO_WHY=""

  local f
  for f in .mcp.json .cursor/mcp.json .gemini/settings.json .gemini/antigravity/mcp_config.json; do
    [[ -f "$f" ]] || continue
    if grep -qi '"ctxo"' "$f" 2>/dev/null; then
      CTXO_CFG_FOUND=1
      break
    fi
  done

  if [[ -d .ctxo ]] || [[ -f .ctxo/index-manifest.json ]] || [[ -f .ctxo/manifest.json ]]; then
    CTXO_IDX_FOUND=1
  fi

  if command -v ctxo &>/dev/null; then
    if ctxo status >/dev/null 2>&1; then
      CTXO_RUNTIME_FOUND=1
    fi
  elif command -v npx &>/dev/null; then
    if npx @ctxo/cli status >/dev/null 2>&1; then
      CTXO_RUNTIME_FOUND=1
    fi
  fi

  if [[ $CTXO_CFG_FOUND -eq 1 && $CTXO_IDX_FOUND -eq 1 && $CTXO_RUNTIME_FOUND -eq 1 ]]; then
    CTXO_STATE="ok"
    return 0
  fi

  if [[ $CTXO_CFG_FOUND -eq 0 && $CTXO_RUNTIME_FOUND -eq 0 ]]; then
    CTXO_STATE="fail"
    CTXO_WHY="No Ctxo MCP config entry found in project-level files and no successful Ctxo runtime status check."
    return 0
  fi

  local missing=()
  [[ $CTXO_CFG_FOUND -eq 0 ]] && missing+=("config")
  [[ $CTXO_IDX_FOUND -eq 0 ]] && missing+=("index")
  [[ $CTXO_RUNTIME_FOUND -eq 0 ]] && missing+=("runtime status")
  CTXO_STATE="warn"
  CTXO_WHY="Ctxo evidence is partial; missing: ${missing[*]}."
}

# remediate title problem url cmd note [url2]  —  problem may be empty; optional 6th url2 prints as second Doc line
remediate() {
  local title=$1
  local problem=$2
  local url=$3
  local cmd=$4
  local note=$5
  local url2="${6-}"
  [[ "$NO_REMED" == 1 ]] && return 0
  echo -e "    ${CYAN}Remediate${NC} ${DIM}[$title]${NC}"
  if [[ -n "$problem" ]]; then
    echo -e "      ${DIM}Why:${NC}  $problem"
  fi
  echo -e "      ${DIM}Try in order —${NC}"
  echo -e "        1) ${DIM}Doc:${NC}  $url"
  local step=2
  if [[ -n "$url2" ]]; then
    echo -e "        ${step}) ${DIM}Doc:${NC}  $url2"
    step=$((step + 1))
  fi
  if [[ -n "$cmd" ]]; then
    echo -e "        ${step}) ${DIM}Run:${NC}  $cmd"
    step=$((step + 1))
  fi
  if [[ -n "$note" ]]; then
    echo -e "        ${step}) ${DIM}Note:${NC} $note"
  fi
}

# out_ok name
# out_line_fail_or_warn: addr_tag, one_line_why, name, req, rem_title, rem_url, rem_cmd, rem_note
out_ok() { echo -e "  ${GREEN}[OK]${NC}  $*"; }
out_manual() {
  local name=$1; shift
  echo -e "  ${YELLOW}[MANUAL]${NC} $name"
  [[ "$NO_REMED" == 1 ]] && return 0
  remediate "$@" 
}
out_line_fail_or_warn() {
  local tag=$1
  local why=$2
  local name=$3
  local req=$4
  local rem_title=$5
  local rem_url=$6
  local rem_cmd=$7
  local rem_note=$8
  local rem_url2="${9-}"
  if [[ $req -eq 0 ]]; then
    ANY_WARN=1
    add_addr_warn "$tag (advisory)"
    ((WARN_N++)) || true
    echo -e "  ${YELLOW}[WARN]${NC} $name ${DIM}(advisory)${NC}"
    if [[ -n "$why" ]]; then
      echo -e "      ${DIM}What’s wrong:${NC} $why"
    fi
    echo -e "      ${DIM}This check is optional;${NC} it does not change the exit code unless ${DIM}STACK_CHECK_STRICT=1${NC}."
    [[ $STRICT == 1 ]] && { HARD_FAIL=1; }
    [[ "$NO_REMED" == 0 ]] && remediate "$rem_title" "$why" "$rem_url" "$rem_cmd" "$rem_note" "$rem_url2"
  else
    add_addr_fail "$tag"
    echo -e "  ${RED}[FAIL]${NC} $name"
    if [[ -n "$why" ]]; then
      echo -e "      ${DIM}What’s wrong:${NC} $why"
    fi
    HARD_FAIL=1
    ((FAIL_N++)) || true
    [[ "$NO_REMED" == 0 ]] && remediate "$rem_title" "$why" "$rem_url" "$rem_cmd" "$rem_note" "$rem_url2"
  fi
}
# out_line_warn: tag, why, label, rem_title, rem_url, rem_cmd, rem_note
out_line_warn() {
  local tag=$1
  local why=$2
  local label=$3
  shift 3
  ANY_WARN=1
  add_addr_warn "$tag (advisory)"
  ((WARN_N++)) || true
  echo -e "  ${YELLOW}[WARN]${NC} $label ${DIM}(advisory)${NC}"
  if [[ -n "$why" ]]; then
    echo -e "      ${DIM}What’s wrong / not detected:${NC} $why"
  fi
  echo -e "      ${DIM}This check is optional;${NC} it does not change the exit code unless ${DIM}STACK_CHECK_STRICT=1${NC}."
  [[ $STRICT == 1 ]] && HARD_FAIL=1
  [[ "$NO_REMED" == 0 ]] && remediate "$1" "$why" "$2" "$3" "$4" "${5-}"
}

echo -e "${GREEN}stack-check${NC} (agentic stack) ${DIM}— cwd: ${PWD}${NC}"
[[ -n "$PHASE" ]] && echo -e "${DIM}config phase: ${PHASE}${NC}"
echo -e "${DIM}STRICT=$STRICT  NO_REMEDIATION=$NO_REMED  DEGRADED_EXIT=$DEGR_EXIT${NC}\n"

echo -e "${YELLOW}Layer 1: Delivery Methodology (spec-kit / BMAD)${NC}"
if [[ -d specs ]]; then
  out_ok "specs/ directory"
else
  out_line_fail_or_warn "L1:specs" \
    "There is no specs/ directory at the repo root, so a spec-kit (or similar) delivery loop is not visible to this check." \
    "specs/ directory" "$REQ_L1" "spec-kit" \
    "https://github.com/github/spec-kit" \
    "Follow GitHub spec-kit README (init / specify flow for your language)." \
    "BMAD alternative: npx bmad-method install (see BMAD-METHOD repo)."
fi
if [[ -d .bmad ]] || { compgen -G "bmad-*" &>/dev/null; } || { compgen -G "BMAD*" &>/dev/null; }; then
  out_ok "optional BMAD-style path (.bmad/ or bmad-*)"
fi

echo -e "\n${YELLOW}Layer 2: Agent Discipline (rules / Superpowers — Agentic Coding Stack)${NC}"
if [[ -f .cursorrules ]] || [[ -f instructions.md ]] || [[ -f .clinerules ]] || [[ -f AGENTS.md ]]; then
  out_ok "agent rules (project: .cursorrules, instructions, .clinerules, or AGENTS.md)"
else
  out_line_fail_or_warn "L2:agent-rules" \
    "The repo has none of: .cursorrules, instructions.md, .clinerules, AGENTS.md at the root — the agent has no project-level rules file to follow." \
    "agent rules in repo root" "$REQ_L2" "Cursor rules" \
    "https://docs.cursor.com/context/rules-for-ai" \
    "Add .cursorrules, instructions.md, .clinerules, or AGENTS.md at the repo root." \
    "Portable convention: https://agents.md"
fi

if layer2_superpowers_signal; then
  out_ok "Superpowers / Layer 2 stack signal (skills path or root doc reference to obra/superpowers)"
else
  SP_REM_NOTE="Plugin loads Superpowers in your editor; stack-check only reads the repo. To clear this check, add a line mentioning obra/superpowers in README.md, AGENTS.md, or another scanned root file, or vendor skills/using-superpowers/."
  if [[ $REQ_L2_SUPERPOWERS -eq 0 ]]; then
    out_line_warn "L2:superpowers" \
      "No repo-local Superpowers signal (vendored skills/using-superpowers, .claude/skills, .cursor/skills, or root doc such as README.md / AGENTS.md mentioning obra/superpowers). Plugin-only installs are invisible here — add a doc line or vendor skills if you want this check to pass." \
      "Superpowers signal (Layer 2, optional)" \
      "Agentic stack + Superpowers" \
      "$STACK_GUIDE_URL" \
      "Cursor: /add-plugin superpowers  ·  Claude Code: /plugin install superpowers@claude-plugins-official (see Superpowers README)." \
      "$SP_REM_NOTE" \
      "$SUPERPOWERS_INSTALL_URL"
  else
    out_line_fail_or_warn "L2:superpowers" \
      "This project’s config sets require_layer2_superpowers but no repo-local Superpowers signal was found (see advisory text in default mode)." \
      "Superpowers signal (Layer 2)" 1 "Agentic stack + Superpowers" \
      "$STACK_GUIDE_URL" \
      "Cursor: /add-plugin superpowers  ·  Claude Code: /plugin install superpowers@claude-plugins-official." \
      "require_layer2_superpowers: true in .stack-check.yaml — add a repo-local signal (README.md, AGENTS.md, or vendor skills/using-superpowers/) so this check can pass." \
      "$SUPERPOWERS_INSTALL_URL"
  fi
fi

echo -e "\n${YELLOW}Layer 3: Technical Context (docs + graded Ctxo evidence)${NC}"
if [[ -f README.md ]] || [[ -f PROJECT.md ]]; then
  out_ok "README.md or PROJECT.md"
else
  out_line_fail_or_warn "L3:readme" \
    "No README.md or PROJECT.md at the repo root, so new contributors and agents have no default orientation doc." \
    "README.md or PROJECT.md" "$REQ_L3" "project documentation" \
    "https://github.com" \
    "Add README.md (or PROJECT.md) with intent and how to work in the repo." \
    "This does not replace Ctxo or semantic tools — confirm those in the checklist."
fi

layer3_ctxo_health
if [[ "$CTXO_STATE" == "ok" ]]; then
  out_ok "Ctxo runtime health: configured + indexed + status healthy"
else
  local_ctxo_req=0
  [[ $REQ_L3_CTXO -eq 1 ]] && local_ctxo_req=1
  [[ "$CTXO_STATE" == "fail" ]] && local_ctxo_req=1
  out_line_fail_or_warn "L3:ctxo" \
    "$CTXO_WHY" \
    "Ctxo runtime health" "$local_ctxo_req" "Ctxo runtime health" \
    "$CTXO_DOC_URL" \
    "Configure MCP (ctxo), run ctxo index, then verify ctxo status in the repo root." \
    "Set require_layer3_ctxo: true in .stack-check.yaml to enforce this in strict phases."
fi
if [[ "$CTXO_STATE" != "ok" ]]; then
  if [[ "$NO_REMED" == 0 ]]; then
    out_manual "Ctxo post-install semantic checks (secondary)" "Ctxo semantic checks" \
      "Shell checks cannot prove semantic answer quality; run a quick semantic check in your IDE/client after setup." \
      "$CTXO_DOC_URL" \
      "Call one Ctxo tool (for example blast radius) in your client and verify meaningful output." \
      "Confirm in ${READINESS_DOC}: blast radius, logic slices, why-context."
  else
    echo -e "  ${YELLOW}[MANUAL]${NC} Ctxo post-install semantic checks — see ${READINESS_DOC}"
  fi
fi

echo -e "\n${YELLOW}Layer 4: Token optimization (RTK, context-mode)${NC}"
if command -v rtk &>/dev/null; then
  out_ok "rtk in PATH"
else
  if [[ $REQ_L4_RTK -eq 0 ]]; then
    out_line_warn "L4:rtk" \
      "The rtk command was not found on PATH. This check is optional unless your .stack-check.yaml sets require_layer4_rtk: true." \
      "rtk in PATH" "RTK (rtk-ai)" "https://github.com/rtk-ai/rtk" \
      "brew install rtk  OR  curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh" \
      "Then: rtk init -g  or  rtk init -g --agent cursor  (see repo README for Gemini/Codex)"
  else
    out_line_fail_or_warn "L4:rtk" \
      "This project’s config requires rtk (require_layer4_rtk) but the rtk command is not on PATH." \
      "rtk in PATH" 1 "RTK (rtk-ai)" "https://github.com/rtk-ai/rtk" \
      "brew install rtk  OR  curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh" \
      "This phase requires rtk; see repo README for hook setup."
  fi
fi

ctx_found=0
if [[ -d .cursor ]]; then
  if grep -r "context" .cursor 2>/dev/null | grep -qiE "mode|mcp" 2>/dev/null; then
    ctx_found=1
  fi
fi
if [[ -d mcps ]]; then
  if grep -R "context" mcps 2>/dev/null | head -1 | grep -q .; then
    ctx_found=1
  fi
fi
if [[ -f mcp.json ]] && grep -q "context" mcp.json 2>/dev/null; then
  ctx_found=1
fi

if [[ $ctx_found -eq 1 ]]; then
  out_ok "MCP / context heuristics (optional): pattern seen under .cursor/ or mcp*"
else
  if [[ $REQ_L4_CONTEXT_MODE -eq 0 ]]; then
    out_line_warn "L4:context-mode" \
      "We only grep for the word “context” under .cursor/, mcps/, or mcp.json. Nothing matched — you may still have a valid setup; confirm in the IDE (this signal is shallow)." \
      "context-mode in MCP (heuristic, optional)" "context-mode" \
      "https://blog.devgenius.io/the-agentic-coding-stack-7-tools-5-layers-and-the-missing-link-nobody-has-built-yet-de264b260db3" \
      "Add a context / sandbox MCP server in .cursor (or your IDE) and ensure the agent uses it for long research." \
      "False OK/WARN is possible; verify in the IDE (Layer 4 in stack article)."
  else
    out_line_fail_or_warn "L4:context-mode" \
      "This project’s config requires context-mode evidence (require_layer4_context_mode) but the shallow grep did not find a match under .cursor/, mcps/, or mcp.json." \
      "context-mode in MCP" 1 "context-mode" \
      "https://blog.devgenius.io/the-agentic-coding-stack-7-tools-5-layers-and-the-missing-link-nobody-has-built-yet-de264b260db3" \
      "Configure context-mode in MCP per your product docs and ensure file content matches the heuristic or adjust the check." \
      "This phase has require_layer4_context_mode: true in .stack-check.yaml"
  fi
fi

echo -e "\n${YELLOW}Layer 5: Product surface (git / GSD)${NC}"
if [[ -d .git ]]; then
  out_ok "git repository (proxy for an integrated VCS / surface)"
else
  out_line_fail_or_warn "L5:git" \
    "This directory is not a git working tree (no .git) — stack checks expect version control for the app surface." \
    ".git (version control)" "$REQ_L5_GIT" "git" \
    "https://git-scm.com/doc" \
    "git init" \
    "gsd-2, worktrees, and recovery are still manual; see ${READINESS_DOC}"
fi

gsd_found=0
if command -v gsd &>/dev/null; then
  gsd_found=1
fi
if [[ -d .gsd ]] || [[ -d .planning ]]; then
  gsd_found=1
fi
if [[ $gsd_found -eq 1 ]]; then
  out_ok "GSD / planning signal (.gsd, .planning, or gsd on PATH)"
else
  if [[ $REQ_L5_GSD -eq 0 ]]; then
    out_line_warn "L5:gsd" \
      "No gsd on PATH and no .gsd/ or .planning/ — GSD-style planning is optional unless require_layer5_gsd is set." \
      "GSD or .planning/ (optional)" "GSD" \
      "https://github.com" \
      "Use your team’s GSD or milestone workflow; gsd-2 is the “product surface” in the stack article." \
      "Optional: add .planning/ (e.g. GSD v1) or install a gsd CLI if your org uses it."
  else
    out_line_fail_or_warn "L5:gsd" \
      "This project’s config requires a GSD signal (require_layer5_gsd) but none of gsd on PATH, .gsd/, or .planning/ was found." \
      "GSD or .planning" 1 "GSD" \
      "https://github.com" \
      "Add .gsd, .planning, or gsd on PATH per your org." \
      "require_layer5_gsd: true in your stack-check config"
  fi
fi

echo -e "\n${YELLOW}---${NC}"
if [[ $HARD_FAIL -gt 0 ]]; then
  VERDICT="not_ready"
  EXIT=1
elif [[ $ANY_WARN -gt 0 ]]; then
  VERDICT="degraded"
  EXIT=0
  [[ $DEGR_EXIT == 1 ]] && EXIT=2
else
  VERDICT="ready"
  EXIT=0
fi
echo -e "VERDICT: ${CYAN}$VERDICT${NC} (required-check failures: $FAIL_N, advisory warnings: $WARN_N)"
if [[ -n "$_ADDR_FAIL" ]]; then
  echo -e "  ${DIM}Address (required):${NC}  $_ADDR_FAIL"
fi
if [[ -n "$_ADDR_WARN" ]]; then
  echo -e "  ${DIM}Advisory only:${NC}        $_ADDR_WARN"
fi
if [[ -n "$_ADDR_WARN" ]]; then
  echo -e "  ${DIM}Exit policy:${NC}  Advisory items do not use exit 1 by themselves. Set ${DIM}STACK_CHECK_STRICT=1${NC} to treat them as failure; set ${DIM}STACK_CHECK_DEGRADED_EXIT=1${NC} to use exit 2 on degraded (warnings without hard fail)."
fi
if [[ $STRICT == 1 ]]; then
